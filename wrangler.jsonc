{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "composa",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_NAME": "Composa",
    "APP_LOCALE": "zh-CN",
    "TIMEZONE": "Asia/Singapore",
    "DAILY_PLAN_TIME": "08:00",
    "DAILY_PLAN_TARGETS": "",
    "AI_BASE_URL": "https://api.openai.com/v1",
    "AI_MODEL": "gpt-4.1-mini",
    "AI_EMBEDDING_MODEL": "",
    "AI_MAX_TOKENS": "600",
    "AI_TIMEOUT_MS": "15000",
    "AI_DAILY_REQUEST_LIMIT": "100",
    "URL_FETCH_TIMEOUT_MS": "6000",
    "URL_MAX_BYTES": "524288",
    "TELEGRAM_ALLOWED_USER_IDS": "",
    "QQ_ALLOWED_USER_OPENIDS": "",
    "QQ_APP_ID": "",
    "QQ_API_BASE_URL": "https://api.bot.qq.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "composa",
      "database_id": "6bba1d9f-2338-491c-a9d4-c51e3f47e64c",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "composa-reminders",
      "binding": "REMINDER_WORKFLOW",
      "class_name": "ReminderWorkflow"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
